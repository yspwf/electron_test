import { app, BrowserWindow, WebContentsView, ipcMain } from 'electron'
import path from 'path'

let mainWindow: BrowserWindow | null = null
const tabViews: WebContentsView[] = []
let activeTabIndex = 0

function createTab(url: string, partition: string): WebContentsView {
  const view = new WebContentsView({
    webPreferences: {
      partition,
      sandbox: true,
    },
  })
  if (!mainWindow) return view

  mainWindow.contentView.addChildView(view)
  
  // 伪装移动端 UA，解决淘宝 ERR_FAILED 加载失败
  view.webContents.setUserAgent(
    'Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36'
  );

  view.webContents.openDevTools({ mode: 'detach' });

  void view.webContents.loadURL(url).catch((err) => {
    console.error('tab load url error:', err)
  })
  return view
}

function closeTab(idx: number): void {
  if (!mainWindow) return
  const view = tabViews[idx]
  if (!view) return

  mainWindow.contentView.removeChildView(view);
  (view.webContents as unknown as { destroy(): void }).destroy();
  tabViews.splice(idx, 1);

  if (activeTabIndex >= tabViews.length) {
    activeTabIndex = Math.max(0, tabViews.length - 1)
  }

  if (tabViews.length > 0) {
    switchTab(activeTabIndex)
  }
}

function switchTab(idx: number): void {
  if (!mainWindow || tabViews.length === 0) return
  if (idx < 0 || idx >= tabViews.length) return

  activeTabIndex = idx
  const [winWidth = 1000, winHeight = 700] = mainWindow.getContentSize()
  const tabBarHeight = 80
  const contentHeight = Math.max(winHeight - tabBarHeight, 100)

  tabViews.forEach((view, i) => {
    if (i === idx) {
      view.setBounds({ x: 0, y: tabBarHeight, width: winWidth, height: contentHeight })
    } else {
      // 移出视口隐藏，保留页面状态
      view.setBounds({ x: 0, y: 9999, width: winWidth, height: contentHeight })
    }
  })
}

let resizeTimer: NodeJS.Timeout | null = null
function onWindowResize() {
  if (resizeTimer) clearTimeout(resizeTimer)
  resizeTimer = setTimeout(() => {
    switchTab(activeTabIndex)
  }, 50)
}

async function bootstrap() {
  mainWindow = new BrowserWindow({
    width: 1000,
    height: 700,
    webPreferences: {
      preload: path.join(__dirname, './preload.js'),
      contextIsolation: true, // 必须开启，contextBridge 才会生效
      nodeIntegration: false,
      sandbox: true,
    },
  })

  // 初始化两个隔离账号 Tab
  tabViews.push(createTab('https://m.taobao.com', 'persist:account1'))
  tabViews.push(createTab('https://m.taobao.com', 'persist:account2'))

  mainWindow.on('resize', onWindowResize)
  switchTab(0)

  await mainWindow.loadFile(path.join(__dirname, '../renderer/tabbar.html'));

  await mainWindow.webContents.openDevTools({mode: 'detach'});
  
  // 开发调试：打开标签栏控制台，排查完注释掉
  // mainWindow.webContents.openDevTools({ mode: 'detach' })

  mainWindow.on('closed', () => {
    tabViews.forEach((v) => {
      // v.webContents.destroy()
      (v.webContents as unknown as { destroy(): void }).destroy()
    })
    tabViews.length = 0
    mainWindow = null
  })
}

// 全局 IPC 事件监听
ipcMain.on('switch-tab', (_e, idx: number) => {
  if (!mainWindow) return
  switchTab(idx)
})

ipcMain.on('close-tab', (_e, idx: number) => {
  if (!mainWindow) return
  closeTab(idx)
})

app.whenReady().then(bootstrap)

app.on('window-all-closed', () => {
  if (process.platform !== 'darwin') app.quit()
})

app.on('activate', () => {
  if (BrowserWindow.getAllWindows().length === 0) void bootstrap()
})
